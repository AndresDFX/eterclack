{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false
  },
  // La semilla se compila junto al servidor: en producción se ejecuta desde
  // dist/, donde sus imports relativos a ../src/ sí resuelven. Sin esto habría
  // que meter el código fuente en la imagen final solo para poder sembrar.
  "include": ["src/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "dist", "node_modules"]
}
