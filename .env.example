# ─── Aplicación ──────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=EterClack
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# ─── Puertos publicados en el host ───────────────────────────────
WEB_PORT=5173
API_PORT=3000
POSTGRES_PORT=55432
REDIS_PORT=56379
S3_PORT=9000
S3_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ─── Base de datos ───────────────────────────────────────────────
POSTGRES_USER=eterclack
POSTGRES_PASSWORD=eterclack_dev
POSTGRES_DB=eterclack

# ─── Sesiones (cambiar en producción por 32+ bytes aleatorios) ───
JWT_ACCESS_SECRET=dev_access_secret_cambiar_en_produccion_32b
JWT_REFRESH_SECRET=dev_refresh_secret_cambiar_en_produccion_32b
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=dev_cookie_secret_cambiar_en_produccion_32b

# ─── Almacenamiento S3 (MinIO local · B2/MinIO en producción) ────
S3_ACCESS_KEY=eterclack
S3_SECRET_KEY=eterclack_dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PHOTOS=eterclack-photos
S3_BUCKET_CONTRACTS=eterclack-contracts
S3_BUCKET_PUBLIC=eterclack-public
S3_UPLOAD_URL_TTL=300
S3_DOWNLOAD_URL_TTL=900

# ─── Correo ──────────────────────────────────────────────────────
# mailpit = captura local · smtp = servidor propio · relay = proveedor externo
MAIL_TRANSPORT=mailpit
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM_NAME=EterClack
MAIL_FROM_ADDRESS=no-reply@eterclack.com
MAIL_REPLY_TO=hola@eterclack.com
MAIL_RATE_PER_MINUTE=4

# ─── Wompi: recaudo (sandbox) ────────────────────────────────────
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ─── Wompi: dispersión (Pagos a Terceros) ────────────────────────
# Base URL a confirmar en la colección Postman/SwaggerHub de Wompi
WOMPI_PAYOUTS_BASE_URL=
WOMPI_PAYOUTS_API_KEY=
WOMPI_PAYOUTS_USER_PRINCIPAL_ID=
WOMPI_PAYOUTS_ACCOUNT_ID=
PAYOUTS_ENABLED=false
PAYOUTS_REQUIRE_ADMIN_APPROVAL=true

# ─── Reglas de negocio (enteros: bps y centavos) ─────────────────
PLATFORM_COMMISSION_BPS=1500
PAYOUT_HOLD_DAYS=5
PAYOUT_MIN_AMOUNT_CENTS=5000000
